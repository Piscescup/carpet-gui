{
	"schemaVersion": 1,
	"id": "carpet-gui",
	"version": "${version}",
	"name": "Carpet GUI",
	"description": "A graphical workspace for browsing Carpet rules, editing values, and managing rule groups and presets.",
	"authors": [
		"PiscesCup"
	],
	"contact": {
		"homepage": "https://github.com/Piscescup/carpet-gui",
		"sources": "https://github.com/Piscescup/carpet-gui",
		"issues": "https://github.com/Piscescup/carpet-gui/issues"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/carpet-gui/icon.png",
	"environment": "*",
	"entrypoints": {
		"modmenu": [
          "io.github.piscescup.fabricmc.carpetgui.modmenu.CarpetGuiModMenu"
		],
		"main": [
			"io.github.piscescup.fabricmc.carpetgui.CarpetGUI"
		],
		"client": [
			"io.github.piscescup.fabricmc.carpetgui.client.CarpetGUIClient"
		],
		"fabric-datagen": [
			"io.github.piscescup.fabricmc.carpetgui.CarpetGUIDataGenerator"
		]
	},
	"mixins": [
		"carpet-gui.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_dependency}",
		"java": "${java_dependency}",
		"fabric-api": "*",
		"carpet": "${carpet_dependency}",
		"tcdcommons": "${tcdcommons_dependency}"
	},
	"suggests": {
		"modmenu": "${modmenu_dependency}"
	}
}
